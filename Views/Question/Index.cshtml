@model List<EtkinlikAnketSistemi.Models.SurveyQuestion>

@{
    ViewData["Title"] = "Sorular";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="page-title mb-1">Sorular</h2>
        <p class="page-subtitle"><strong>Etkinlik:</strong> @ViewBag.EventTitle</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Event" asp-action="Index" class="btn btn-secondary">Etkinliklere Dön</a>
        <a asp-action="Create"
           asp-route-eventSurveyId="@ViewBag.EventSurveyId"
           class="btn custom-btn-primary">
            + Yeni Soru
        </a>
    </div>
</div>

<div class="app-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 90px;">Sıra</th>
                        <th>Soru</th>
                        <th style="width: 140px;">Tip</th>
                        <th style="width: 180px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.DisplayOrder</td>
                                <td>@item.QuestionText</td>
                                <td>@item.QuestionType</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning">
                                            Düzenle
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-danger">
                                            Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">Henüz soru eklenmemiş.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>