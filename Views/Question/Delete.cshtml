@model EtkinlikAnketSistemi.Models.SurveyQuestion

@{
    ViewData["Title"] = "Soru Sil";
}

<div class="container mt-4">
    <h2 class="text-danger">Soru Sil</h2>
    <p><strong>Etkinlik:</strong> @ViewBag.EventTitle</p>

    <div class="alert alert-warning mt-3">
        Bu soruyu silmek istediğinize emin misiniz?
    </div>

    <div class="card shadow-sm border-0 mt-3">
        <div class="card-body">
            <p><strong>Soru:</strong> @Model.QuestionText</p>
            <p><strong>Tip:</strong> @Model.QuestionType</p>
            <p><strong>Sıra:</strong> @Model.DisplayOrder</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" asp-route-eventSurveyId="@Model.EventSurveyId" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>