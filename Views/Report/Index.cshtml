@model EtkinlikAnketSistemi.Models.ReportPageViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Rapor";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Anket Raporu</h2>
            <p class="mb-0"><strong>Program:</strong> @Model.ProgramName</p>
            <p class="mb-0"><strong>Etkinlik:</strong> @Model.EventTitle</p>
            <p class="mb-0"><strong>Tarih:</strong> @Model.EventDate.ToShortDateString()</p>
        </div>

        <div>
            <a asp-controller="Event" asp-action="Index" class="btn btn-secondary">
                Etkinliklere Dön
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Toplam Katılımcı</h6>
                    <h3 class="mb-0">@Model.TotalParticipants</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Toplam Soru</h6>
                    <h3 class="mb-0">@Model.Questions.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Likert / Açık Uçlu</h6>
                    <h3 class="mb-0">
                        @Model.Questions.Count(x => x.QuestionType == "Likert")
                        /
                        @Model.Questions.Count(x => x.QuestionType == "Text")
                    </h3>
                </div>
            </div>
        </div>
    </div>

    @foreach (var question in Model.Questions.OrderBy(q => q.DisplayOrder))
    {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body">
                <h5 class="mb-3">@question.DisplayOrder. @question.QuestionText</h5>

                @if (question.QuestionType == "Likert")
                {
                    var chartLabels = question.LikertResults.Select(x => x.OptionText).ToList();
                    var chartData = question.LikertResults.Select(x => x.Count).ToList();

                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Seçenek</th>
                                    <th style="width: 160px;">Kişi Sayısı</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in question.LikertResults)
                                {
                                    <tr>
                                        <td>@item.OptionText</td>
                                        <td><strong>@item.Count kişi</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <canvas id="chart_@question.QuestionId" height="110"></canvas>
                    </div>

                    <script>
                        window.reportCharts = window.reportCharts || [];
                        window.reportCharts.push({
                            chartId: "chart_@question.QuestionId",
                            labels: @Html.Raw(JsonSerializer.Serialize(chartLabels)),
                            data: @Html.Raw(JsonSerializer.Serialize(chartData))
                        });
                    </script>
                }
                else if (question.QuestionType == "Text")
                {
                    @if (question.TextAnswers.Any())
                    {
                        <ol class="mb-0 ps-3">
                            @foreach (var answer in question.TextAnswers)
                            {
                                <li class="mb-2">@answer</li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Bu soruya henüz yazılı cevap verilmemiş.
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="/lib/chart.js/chart.umd.js"></script>

    <script>
        if (window.reportCharts && window.reportCharts.length > 0) {
            window.reportCharts.forEach(function (item) {
                const canvas = document.getElementById(item.chartId);

                if (!canvas) return;

                new Chart(canvas, {
                    type: 'bar',
                    data: {
                        labels: item.labels,
                        datasets: [{
                            label: 'Kişi Sayısı',
                            data: item.data,
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: true
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    precision: 0
                                }
                            }
                        }
                    }
                });
            });
        }
    </script>
}