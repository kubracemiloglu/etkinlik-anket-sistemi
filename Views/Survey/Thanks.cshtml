@model EtkinlikAnketSistemi.Models.SurveyThanksViewModel

@{
    ViewData["Title"] = "Teşekkürler";
}

<div class="thanks-card">
    <div class="thanks-icon">✓</div>
    <h2 class="page-title mb-3">Teşekkür ederiz</h2>
    <p class="lead mb-3">
        “@Model.EventTitle” etkinliği için anketiniz başarıyla kaydedildi.
    </p>
    <p class="text-muted mb-0">
        Geri bildiriminiz, gelecekte düzenlenecek etkinliklerin geliştirilmesine katkı sağlayacaktır.
    </p>
</div>


